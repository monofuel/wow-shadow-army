# Peregrine — Accelerated Leveling policy (unheaded lua-bot + grind entry).
#
# Base image is monofuel-vanilla-wow's lua_bot_player_runtime (vanilla-wow-player
# built with -d:luaBotVm). Its CMD launches the unheaded embedded lua-bot from
# COWORLD_LUA_REPO / COWORLD_LUA_ENTRY; this layer only bakes the tracked lua
# code and locks the entry module.
#
# Only tracked code is copied. lua/data/ (generated quest-hub tables) is local
# data and stays out of the image; accelerated.lua runs without it (seen-givers
# only). An operator who has it can mount it read-only at runtime:
#   -v <local>/lua/data:/opt/policy/lua/data:ro
#
# Build (from this worktree, after the base image exists):
#   make peregrine-image
#
# Upload:
#   uv run coworld upload-policy peregrine:latest --name peregrine
#   uv run --extra dev vanilla-wow submit peregrine:vN \
#     --league league_faf92aca-4edd-4591-923f-27b09af629bb \
#     --race tauren --character-class druid --gender male --json

ARG LUA_BOT_PLAYER_IMAGE=coworld-lua-bot-player:latest
FROM ${LUA_BOT_PLAYER_IMAGE}

COPY lua/entry/ /opt/policy/lua/entry/
COPY lua/tools/ /opt/policy/lua/tools/

ENV COWORLD_LUA_REPO=/opt/policy
ENV COWORLD_LUA_ENTRY=accelerated
