# Peregrine — Accelerated Leveling policy (rendered lua-bot + grind entry).
#
# Base image is monofuel-vanilla-wow's lua_bot_player_runtime (vanilla-wow-player
# built with -d:luaBotVm). This layer only bakes the league lua/ tree and locks
# the entry module.
#
# Build (from this worktree, after the base image exists):
#   make peregrine-image
#
# Upload:
#   uv run coworld upload-policy peregrine:latest --name peregrine
#   uv run --extra dev vanilla-wow submit peregrine:vN \
#     --league league_faf92aca-4edd-4591-923f-27b09af629bb \
#     --race tauren --character-class druid --gender male --json

# syntax=docker/dockerfile:1.7

ARG LUA_BOT_PLAYER_IMAGE=coworld-lua-bot-player:latest
FROM ${LUA_BOT_PLAYER_IMAGE}

COPY lua/ /opt/policy/lua/

ENV COWORLD_LUA_REPO=/opt/policy
ENV COWORLD_LUA_ENTRY=accelerated

CMD ["tini", "--", "/usr/local/bin/lua_bot_entry.sh"]
