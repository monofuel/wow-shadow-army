# Petrel — hosted Traverse policy (unheaded lua-bot + the traverse entry).
#
# Base image is monofuel-vanilla-wow's lua_bot_player_runtime (vanilla-wow-player
# built with -d:luaBotVm). Its CMD launches the unheaded embedded lua-bot from
# COWORLD_LUA_REPO / COWORLD_LUA_ENTRY; this layer only bakes the tracked lua
# code and locks the entry module. The spawn→Everlook speedrun brain: desert
# crossing, fatigue swim, Merchant Bay, Barrens connector, painted northern
# roads.
#
# Only tracked code is copied. The route beats in lua/config/ are local data
# derived from world data and recorded play, so they never enter an image
# layer. traverse.lua requires them at boot: this image does not run until an
# operator mounts that directory read-only at runtime:
#   -v <local>/lua/config:/opt/policy/lua/config:ro
#
# Build (from this worktree, after the base image exists):
#   make petrel-image
#
# Upload (see playbooks/upload-bot.md — upload is NOT submit):
#   uv run coworld upload-policy petrel:latest --name petrel
#   uv run --extra dev vanilla-wow submit petrel:vN \
#     --league league_0f38d762-930a-41d3-9979-1858dd52c1ae --json

ARG LUA_BOT_PLAYER_IMAGE=coworld-lua-bot-player:latest
FROM ${LUA_BOT_PLAYER_IMAGE}

COPY lua/entry/ /opt/policy/lua/entry/
COPY lua/tools/ /opt/policy/lua/tools/

ENV COWORLD_LUA_REPO=/opt/policy
ENV COWORLD_LUA_ENTRY=traverse
# The wet chain is unconditional — the PETREL_SWIM gate was removed
# outright after it shipped v1/v2/v3 with swim OFF (ticket 0015).
